<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- REQUISITO OBLIGATORIO: Permiso para que la app pueda usar Internet -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Projecte1_Repo_App"
        android:usesCleartextTraffic="true"> <!-- AÑADIDO: Vinculación con tu archivo de seguridad de red -->


        <!-- Pantalla de inicio principal (Única con Launcher) -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- CORREGIDO: Eliminado el filtro launcher repetido para evitar conflictos -->
        <activity
            android:name=".DetallEsdevenimentActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Pantalla de la cistella -->
        <activity
            android:name=".CestaActivity"
            android:exported="false" />

        <!-- Pantalla de la cartellera de películas/eventos -->
        <activity
            android:name=".CartelleraActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".LesMevesEntradesActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
    </application>

</manifest>