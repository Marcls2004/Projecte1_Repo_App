<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <!-- Este contenedor organiza todo verticalmente y se centra en la pantalla -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Título Principal -->
        <TextView
            android:id="@+id/titleLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Entradium"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:layout_marginBottom="4dp"/>

        <!-- Subtítulo -->
        <TextView
            android:id="@+id/subtitleLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Configuración del Servidor"
            android:textSize="13sp"
            android:textColor="#36454F"
            android:layout_marginBottom="24dp"/>

        <!-- Etiqueta Nombre -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nom d'Usuari:"
            android:textSize="14sp"
            android:layout_marginBottom="4dp"/>

        <!-- Campo Nombre -->
        <EditText
            android:id="@+id/nameField"
            android:layout_width="250dp"
            android:layout_height="wrap_content"
            android:inputType="textPersonName"
            android:layout_marginBottom="16dp"
            android:textAlignment="center"/>

        <!-- Etiqueta URL -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="URL del Servidor:"
            android:textSize="14sp"
            android:layout_marginBottom="4dp"/>

        <!-- Campo URL -->
        <EditText
            android:id="@+id/serverField"
            android:layout_width="250dp"
            android:layout_height="wrap_content"
            android:text="ws://platea3.ieti.site"
            android:inputType="textUri"
            android:layout_marginBottom="24dp"
            android:textAlignment="center"/>

        <!-- Botón Conectar -->
        <Button
            android:id="@+id/connectButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="INICIAR SESSIO"
            android:backgroundTint="#27ae60"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:layout_marginBottom="12dp"/>

        <!-- Estado -->
        <TextView
            android:id="@+id/statusLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="14sp"/>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
